// Settings that differ per team account. Fill these in once (see README.md, "One-time setup").

// From GoogleService-Info.plist: the REVERSED_CLIENT_ID value. Google sign-in comes back to the app through it.
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.14469766944-q6o4phn4d9om9rk81uoi3tg6bg785tar

// The Apple Developer team that signs the app (10 characters, from developer.apple.com › Membership).
DEVELOPMENT_TEAM = HCA64TLL48

// The app's bundle ID. Personal-team test installs override it (dev-install.sh) with org.systemoverload.team.dev.
BUNDLE_BASE = org.systemoverload.team

// Push, universal links and the shared widget data need a paid team. dev-install.sh blanks these for the Personal Team.
APP_ENTITLEMENTS = SOR/SOR.entitlements
WIDGET_ENTITLEMENTS = SORWidget/SORWidget.entitlements
